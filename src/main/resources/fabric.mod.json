{
  "schemaVersion": 1,
  "id": "trackwright",
  "version": "${version}",
  "name": "Create Fly: Trackwright",
  "description": "Track laying helpers for Create Fly: a placement guide, straight track through solid blocks or a tunnel bored with an off-hand pickaxe, connections up to 128 blocks, undo for your last placements, full speed on straight connections, seated train passengers safe inside walls, train drills and rollers that spare track equipment and a schedule step that switches a train's actors on or off.",
  "authors": [
    "chaevsfe"
  ],
  "contributors": [
    "E-Thang"
  ],
  "contact": {
    "homepage": "https://github.com/chaevsfe/Trackwright",
    "sources": "https://github.com/chaevsfe/Trackwright",
    "issues": "https://github.com/chaevsfe/Trackwright/issues"
  },
  "license": [
    "GPL-3.0-or-later"
  ],
  "icon": "assets/trackwright/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.chaevsfe.trackwright.Trackwright"
    ],
    "client": [
      "dev.chaevsfe.trackwright.client.TrackwrightClient"
    ]
  },
  "mixins": [
    "trackwright.mixins.json",
    {
      "config": "trackwright.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "${minecraft_dependency_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "${fabric_api_version_range}",
    "create": "${create_fabric_version_range}",
    "java": ">=25"
  }
}
